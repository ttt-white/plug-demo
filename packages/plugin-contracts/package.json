{
  "name": "@tt-plug/plugin-contracts",
  "version": "1.0.2",
  "private": false,
  "description": "Shared host and plugin contracts for the plugin material management system.",
  "homepage": "https://github.com/tujianglin/plug-demo/tree/main/packages/plugin-contracts#readme",
  "bugs": {
    "url": "https://github.com/tujianglin/plug-demo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tujianglin/plug-demo.git",
    "directory": "packages/plugin-contracts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../scripts/generate-plugin-contracts.mjs --check && tsup src/index.ts --format esm --clean --external @tt-plug/plugin-sdk --external zod && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tt-plug/plugin-sdk": "workspace:*",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tt-plug/plugin-sdk": "^1.0.0"
  }
}
