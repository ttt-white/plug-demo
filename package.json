{
  "name": "fms-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "pnpm external:install",
    "postinstall": "pnpm external:build",
    "dev": "node scripts/dev.mjs",
    "build": "pnpm external:build && pnpm -r build",
    "typecheck": "pnpm external:typecheck && pnpm -r typecheck",
    "test": "pnpm external:test && pnpm -r test",
    "lint": "pnpm external:lint && eslint apps packages plugins && oxlint -D react-hooks/rules-of-hooks -D react-hooks/exhaustive-deps -D react-hooks/set-state-in-effect apps packages plugins",
    "external:install": "pnpm --dir external/three install",
    "external:build": "pnpm --dir external/three build",
    "external:dev": "pnpm --dir external/three dev",
    "external:typecheck": "pnpm --dir external/three typecheck",
    "external:test": "pnpm --dir external/three test",
    "external:lint": "pnpm --dir external/three lint",
    "external:setup": "pnpm external:install && pnpm external:build",
    "commit": "git add . && lefthook run pre-commit && git add . && czg --no-verify"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "czg": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "@fms-external/plugin-three": "link:./external/three"
    }
  }
}
