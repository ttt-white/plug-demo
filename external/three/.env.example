# Override the host configured in fms.dev.json without editing the file.
FMS_HOST_URL=http://localhost:3000
# Host repository path, resolved from this plugin repository.
FMS_HOST_WORKSPACE_ROOT=../..
# Set false when the host is already running elsewhere on this machine.
FMS_START_HOST=true
# Skip the readiness check only for CI or a watcher-only session.
FMS_SKIP_HOST_CHECK=false
